<?xml version="1.0" encoding="UTF-8"?>
<?xaml-comp compile="true"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="BrandonTrackerApp.Resources.Styles.LightTheme">

    <!-- Light colors -->
    <Color x:Key="PrimaryBackground">#FFFFFF</Color>
    <Color x:Key="PrimaryBlack">#212121</Color>
    <Color x:Key="PrimaryText">#000000</Color>
    <Color x:Key="NeutralGray">#757575</Color>
    <Color x:Key="PrimaryYellow">#FFEB3B</Color>
    <Color x:Key="StatusColor">#2E7D32</Color>

    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryBackground}" />
    </Style>

    <Style x:Key="LabelPrimary" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
    </Style>

</ResourceDictionary>





