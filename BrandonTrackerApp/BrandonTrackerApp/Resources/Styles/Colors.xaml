<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Institutional Colors -->
    <Color x:Key="PrimaryYellow">#FFD700</Color>
    <Color x:Key="PrimaryBlack">#000000</Color>
    <Color x:Key="PrimaryWhite">#FFFFFF</Color>
    <Color x:Key="NeutralGray">#808080</Color>

    <!-- Brushes  -->
    <SolidColorBrush x:Key="PrimaryYellowBrush" Color="{StaticResource PrimaryYellow}" />
    <SolidColorBrush x:Key="PrimaryBlackBrush" Color="{StaticResource PrimaryBlack}" />
    <SolidColorBrush x:Key="PrimaryWhiteBrush" Color="{StaticResource PrimaryWhite}" />
    <SolidColorBrush x:Key="NeutralGrayBrush" Color="{StaticResource NeutralGray}" />

    <!-- Entrys  -->

    <Color x:Key="EntryBackgroundLight">#F0F0F0</Color>
    <Color x:Key="EntryBackgroundDark">#2C2C2C</Color>

    <Color x:Key="EntryTextColorLight">#000000</Color>
    <Color x:Key="EntryTextColorDark">#FFFFFF</Color>


    <!-- Un verde profesional para estado conectado -->
    <Color x:Key="StatusColor">#2E7D32</Color>




</ResourceDictionary>