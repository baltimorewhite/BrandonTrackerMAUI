<?xml version="1.0" encoding="UTF-8"?>
<?xaml-comp compile="true"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="BrandonTrackerApp.Resources.Styles.DarkTheme">

    <!-- Dark colors -->
    <Color x:Key="PrimaryBackground">#121212</Color>
    <Color x:Key="PrimaryBlack">#FFFFFF</Color>
    <Color x:Key="NeutralGray">#B0B0B0</Color>
    <Color x:Key="PrimaryYellow">#FDD835</Color>
    <Color x:Key="StatusColor">#81C784</Color>
    <Color x:Key="PrimaryText">#FFFFFF</Color>

    <Style x:Key="PageStyle" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryBackground}" />
    </Style>

    <Style x:Key="LabelPrimary" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
    </Style>

</ResourceDictionary>


